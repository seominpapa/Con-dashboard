{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "construction-dashboard",
  "compatibility_date": "2026-08-25",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "construction-dashboard-production",
      "database_id": "b54cc6a4-084a-4f07-b9e1-bbd159cacc84"
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://construction-dashboard-2z9.pages.dev"
  }
