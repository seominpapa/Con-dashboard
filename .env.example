# =========================================================================
# 건설 Dashboard - 환경변수 예시 파일
# 로컬 개발 시: 이 파일을 .dev.vars 로 복사한 뒤 실제 값을 채워 사용하세요.
#   cp .env.example .dev.vars
# 운영 배포 시: wrangler secret put <KEY> 로 Cloudflare Workers Secret에 등록하세요.
#
# ⚠️ 중요: 이 서비스는 "사용자가 직접 API Key를 입력하는 UI"를 제공하지 않습니다.
# 모든 외부 API 자격증명은 서버(Worker) 환경변수 또는 관리자 화면(/admin/integrations,
# /admin/integrations/ai)에서 DB에 암호화 저장하는 방식으로만 관리됩니다.
# 공개데이터/LLM 키가 없으면 Mock 데이터 또는 설정 안내가 표시되며, 아래 인증/세션 값은 필수입니다.
# =========================================================================

# ---- 인증 / 세션 (필수) ----
# 세션 서명 및 관리자 Credential 암호화(AES-GCM)에 사용하는 서버 비밀키.
# 32자 이상의 임의 문자열이어야 하며, 누락되거나 예시값이면 로그인이 비활성화됩니다.
AUTH_SECRET=change-me-to-a-long-random-secret

# 최초 관리자 부트스트랩용 이메일. 이 Google 계정으로 최초 로그인 시 자동으로
# ADMIN + APPROVED 상태로 계정이 생성됩니다. (기존 ADMIN이 이미 있으면 동작하지 않음: 이중 안전장치)
INITIAL_ADMIN_EMAIL=admin@example.com

# true 로 설정하면 위 부트스트랩 로직을 완전히 비활성화합니다. (운영 전환 후 설정 권장)
DISABLE_ADMIN_BOOTSTRAP=false

# ---- Google OAuth 로그인 (필수: 로그인 자체가 Google OAuth 전용) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth Redirect 계산에 사용하는 서비스 기준 URL (예: https://your-project.pages.dev)
APP_BASE_URL=http://localhost:3000

# ---- LLM Provider (AI 브리핑 위젯용, 관리자가 /admin/integrations/ai 에서 연결 가능. ENV는 폴백/초기값) ----
# Claude(Anthropic) 공식 API Key. CLI OAuth 자격증명 파일은 사용하지 않습니다.
ANTHROPIC_API_KEY=
# Codex/OpenAI 공식 API Key.
OPENAI_API_KEY=

# ---- 공공데이터 Provider (미설정 시 각 위젯은 자동으로 Mock 데이터로 동작) ----
# 기상청 단기예보/특보 API
KMA_SERVICE_KEY=
# 한국환경공단 에어코리아 대기질 API
AIRKOREA_SERVICE_KEY=
# 나라장터(조달청) 입찰공고 API
G2B_SERVICE_KEY=
# 법제처 국가법령정보 API
LAW_API_KEY=
# 한국은행 경제통계시스템(ECOS) API - 환율
ECOS_API_KEY=
# 한국석유공사 오피넷(Opinet) API - 유가
OPINET_API_KEY=
# NAVER Cloud Maps Geocoding - 주소 자동 검색/좌표 변환
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# 국가교통정보센터(ITS) - 인근 주요도로 소통/돌발정보
ITS_API_KEY=
